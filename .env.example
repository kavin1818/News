# ---------------------------------------------------------------------------
# Database connection (Prisma)
# ---------------------------------------------------------------------------
# Local development (default) — SQLite file, relative to prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Production / Vercel — hosted PostgreSQL (Neon, Vercel Postgres, Supabase, …).
# When DATABASE_URL starts with postgres:// or postgresql://, the build step
# (scripts/prisma-setup.mjs) automatically selects prisma/schema.postgres.prisma.
#
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
